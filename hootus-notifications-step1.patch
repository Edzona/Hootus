diff --git a/supabase/migrations/20261030000000_notifications.sql b/supabase/migrations/20261030000000_notifications.sql
new file mode 100644
index 0000000..cbef3b3
--- /dev/null
+++ b/supabase/migrations/20261030000000_notifications.sql
@@ -0,0 +1,125 @@
+-- Notifications: things a member should hear about, delivered by one or more
+-- channels (email now; browser push and an in-app bell later).
+--
+-- Messages are grouped: while a conversation's notification is unread, new
+-- messages bump it instead of creating another row. Email is only sent when a
+-- row is created, so a back-and-forth chat sends one email, not one per message.
+create table public.notifications (
+  id bigint generated always as identity primary key,
+  public_id uuid not null unique default gen_random_uuid(),
+  recipient_id bigint not null references public.profiles(id) on delete cascade,
+  kind text not null check (kind in ('message')),
+  -- Who caused it. Kept nullable so later kinds (club posts) can omit it.
+  actor_id bigint references public.profiles(id) on delete set null,
+  conversation_id bigint references public.conversations(id) on delete cascade,
+  -- The message that created this row; email delivery is tied to it.
+  first_message_id bigint references public.messages(id) on delete set null,
+  event_count integer not null default 1 check (event_count > 0),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  read_at timestamptz,
+  -- Delivery bookkeeping, so email reliability can be measured for the pilot.
+  email_status text not null default 'pending'
+    check (email_status in ('pending', 'sending', 'sent', 'failed', 'skipped')),
+  email_attempted_at timestamptz,
+  check (kind <> 'message' or conversation_id is not null)
+);
+
+create index notifications_recipient_idx on public.notifications (recipient_id, updated_at desc);
+-- At most one unread message notification per conversation and recipient.
+create unique index notifications_one_unread_conversation
+  on public.notifications (recipient_id, conversation_id)
+  where read_at is null and kind = 'message';
+
+create function private.notify_message()
+returns trigger
+language plpgsql security definer set search_path = ''
+as $$
+begin
+  insert into public.notifications (recipient_id, kind, actor_id, conversation_id, first_message_id)
+  values (new.recipient_id, 'message', new.sender_id, new.conversation_id, new.id)
+  on conflict (recipient_id, conversation_id) where read_at is null and kind = 'message'
+  do update set
+    event_count = public.notifications.event_count + 1,
+    actor_id = excluded.actor_id,
+    updated_at = excluded.updated_at;
+  return new;
+end;
+$$;
+revoke all on function private.notify_message() from public, anon, authenticated, hootus_api;
+
+create trigger messages_notify
+after insert on public.messages
+for each row when (new.conversation_id is not null)
+execute function private.notify_message();
+
+-- The sender's API request claims the email for the notification its message
+-- created. The recipient's address is private (profiles RLS), so only this
+-- function reads it, only for the message's own sender, and only once.
+create function private.claim_message_email(message_public_id uuid)
+returns table (
+  notification_id uuid,
+  recipient_email text,
+  recipient_name text,
+  sender_name text,
+  listing_title text
+)
+language sql volatile security definer set search_path = ''
+as $$
+  update public.notifications n
+  set email_status = 'sending', email_attempted_at = now()
+  from public.messages m
+  join public.conversations c on c.id = m.conversation_id
+  join public.listings l on l.id = c.listing_id
+  join public.profiles r on r.id = m.recipient_id
+  where m.public_id = message_public_id
+    and m.sender_id = (select private.current_profile_id())
+    and (select private.current_role()) is not null
+    and n.first_message_id = m.id
+    and n.email_status = 'pending'
+  returning n.public_id, r.email, r.full_name,
+    (select p.full_name from public.profiles p where p.id = m.sender_id), l.title
+$$;
+revoke all on function private.claim_message_email(uuid) from public, anon, authenticated, hootus_api;
+grant execute on function private.claim_message_email(uuid) to hootus_api;
+
+-- Record the outcome of a claimed email. Only the claiming sender can finish it,
+-- and only a row that is still 'sending'.
+create function private.finish_notification_email(notification_public_id uuid, outcome text)
+returns boolean
+language sql volatile security definer set search_path = ''
+as $$
+  with done as (
+    update public.notifications n
+    set email_status = outcome
+    from public.messages m
+    where n.public_id = notification_public_id
+      and outcome in ('sent', 'failed', 'skipped')
+      and n.email_status = 'sending'
+      and m.id = n.first_message_id
+      and m.sender_id = (select private.current_profile_id())
+      and (select private.current_role()) is not null
+    returning 1
+  )
+  select exists (select 1 from done)
+$$;
+revoke all on function private.finish_notification_email(uuid, text) from public, anon, authenticated, hootus_api;
+grant execute on function private.finish_notification_email(uuid, text) to hootus_api;
+
+alter table public.notifications enable row level security;
+
+revoke all on sequence public.notifications_id_seq from public, anon, authenticated, hootus_api;
+revoke all on public.notifications from public, anon, authenticated, hootus_api;
+-- Rows are created by the trigger only. Members may read theirs and mark them read.
+grant select on public.notifications to hootus_api;
+grant update (read_at) on public.notifications to hootus_api;
+
+create policy notifications_read on public.notifications for select to hootus_api
+using ((select private.current_role()) is not null
+  and recipient_id = (select private.current_profile_id()));
+
+create policy notifications_mark_read on public.notifications for update to hootus_api
+using ((select private.current_role()) is not null
+  and recipient_id = (select private.current_profile_id()))
+with check ((select private.current_role()) is not null
+  and recipient_id = (select private.current_profile_id()));
diff --git a/supabase/queries/notifications.sql b/supabase/queries/notifications.sql
new file mode 100644
index 0000000..0135c5c
--- /dev/null
+++ b/supabase/queries/notifications.sql
@@ -0,0 +1,40 @@
+/* @name GetNotifications */
+-- RLS limits rows to your own notifications. Newest activity first.
+select n.public_id as id, n.kind, n.event_count, n.created_at, n.updated_at, n.read_at,
+  private.author_name(n.actor_id) as actor_name,
+  c.public_id as conversation, l.title as listing_title
+from public.notifications n
+left join public.conversations c on c.id = n.conversation_id
+left join public.listings l on l.id = c.listing_id
+order by n.updated_at desc, n.id desc
+limit :limit!::int offset :offset!::int;
+
+/* @name CountUnreadNotifications */
+select count(*)::int as unread from public.notifications where read_at is null;
+
+/* @name MarkNotificationRead */
+-- Zero rows means not found or not yours: return 404.
+update public.notifications set read_at = coalesce(read_at, now())
+where public_id = :notificationId!::uuid
+returning public_id as id;
+
+/* @name MarkAllNotificationsRead */
+update public.notifications set read_at = now()
+where read_at is null
+returning public_id as id;
+
+/* @name MarkConversationNotificationsRead */
+-- Opening a conversation clears its notification.
+update public.notifications n set read_at = now()
+from public.conversations c
+where c.id = n.conversation_id
+  and c.public_id = :conversationId!::uuid
+  and n.read_at is null
+returning n.public_id as id;
+
+/* @name ClaimMessageEmail */
+-- Zero rows means no email is due (the conversation already had an unread notification).
+select * from private.claim_message_email(:messageId!::uuid);
+
+/* @name FinishNotificationEmail */
+select private.finish_notification_email(:notificationId!::uuid, :outcome!::text) as finished;
diff --git a/supabase/tests/notifications.sql b/supabase/tests/notifications.sql
new file mode 100644
index 0000000..4fbd403
--- /dev/null
+++ b/supabase/tests/notifications.sql
@@ -0,0 +1,131 @@
+-- Run as postgres in a disposable Supabase project's SQL Editor after migration,
+-- like access_control.sql. All fixtures roll back. Any failure raises an exception.
+begin;
+
+grant hootus_api to postgres;
+
+-- seller (01), buyer (02), outsider (03)
+insert into auth.users (id, email, email_confirmed_at, raw_user_meta_data)
+values
+  ('20000000-0000-0000-0000-000000000001', 'hootus-notify-seller@temple.edu', now(), '{"full_name":"Sam Seller"}'),
+  ('20000000-0000-0000-0000-000000000002', 'hootus-notify-buyer@temple.edu', now(), '{"full_name":"Bea Buyer"}'),
+  ('20000000-0000-0000-0000-000000000003', 'hootus-notify-outsider@temple.edu', now(), '{}');
+
+set local role hootus_api;
+
+-- Seller lists a desk.
+select set_config('request.jwt.claim.sub', '20000000-0000-0000-0000-000000000001', true);
+insert into public.listings (category, title, price_jpy) values ('sales', 'Notify desk', 1500);
+
+-- Buyer starts a conversation and sends two messages.
+select set_config('request.jwt.claim.sub', '20000000-0000-0000-0000-000000000002', true);
+insert into public.conversations (listing_id, seller_id)
+select id, author_id from public.listings where title = 'Notify desk';
+
+create temporary table test_messages (n int, public_id uuid) on commit drop;
+grant all on test_messages to hootus_api;
+
+with sent as (
+  insert into public.messages (conversation_id, recipient_id, body)
+  select c.id, c.seller_id, 'Is it available?' from public.conversations c
+  returning public_id
+) insert into test_messages select 1, public_id from sent;
+with sent as (
+  insert into public.messages (conversation_id, recipient_id, body)
+  select c.id, c.seller_id, 'Can I pick it up today?' from public.conversations c
+  returning public_id
+) insert into test_messages select 2, public_id from sent;
+
+do $$
+declare
+  claimed record;
+begin
+  assert (select count(*) = 0 from public.notifications), 'Buyer must not see the seller''s notification';
+
+  -- Only the first message's email is due, and only once.
+  assert (select count(*) = 0 from private.claim_message_email(
+    (select public_id from test_messages where n = 2))), 'Second unread message must not email again';
+  select * into claimed from private.claim_message_email((select public_id from test_messages where n = 1));
+  assert claimed.recipient_email = 'hootus-notify-seller@temple.edu', 'Claim must return the recipient address';
+  assert claimed.sender_name = 'Bea Buyer' and claimed.listing_title = 'Notify desk', 'Claim must describe the message';
+  assert (select count(*) = 0 from private.claim_message_email(
+    (select public_id from test_messages where n = 1))), 'An email must only be claimed once';
+
+  assert not private.finish_notification_email(claimed.notification_id, 'delivered'), 'Unknown outcomes are rejected';
+  assert private.finish_notification_email(claimed.notification_id, 'sent'), 'Sender records the outcome';
+  assert not private.finish_notification_email(claimed.notification_id, 'failed'), 'An outcome is final';
+
+  begin
+    insert into public.notifications (recipient_id, kind, conversation_id)
+    select seller_id, 'message', id from public.conversations;
+    raise exception 'Members must not create notifications directly';
+  exception when insufficient_privilege then null;
+  end;
+end;
+$$;
+
+-- Outsider sees and changes nothing, and cannot claim or finish.
+select set_config('request.jwt.claim.sub', '20000000-0000-0000-0000-000000000003', true);
+do $$
+begin
+  assert (select count(*) = 0 from public.notifications), 'Outsider must see no notifications';
+  assert (select count(*) = 0 from private.claim_message_email(
+    (select public_id from test_messages where n = 1))), 'Outsider must not claim another sender''s email';
+end;
+$$;
+update public.notifications set read_at = now();
+
+-- Seller sees one grouped notification, and the email address never leaks to them via claims either.
+select set_config('request.jwt.claim.sub', '20000000-0000-0000-0000-000000000001', true);
+do $$
+begin
+  assert (select count(*) = 1 and min(event_count) = 2 and bool_and(read_at is null)
+    from public.notifications), 'Seller must see one unread notification grouping both messages';
+  assert (select min(email_status) = 'sent' from public.notifications), 'Email outcome must be recorded';
+  assert (select count(*) = 0 from private.claim_message_email(
+    (select public_id from test_messages where n = 2))), 'Recipient must not claim the sender''s email';
+  begin
+    update public.notifications set email_status = 'pending';
+    raise exception 'Members must not change delivery status';
+  exception when insufficient_privilege then null;
+  end;
+end;
+$$;
+
+-- Seller opens the conversation (same statement as MarkConversationNotificationsRead) and replies.
+update public.notifications n set read_at = now()
+from public.conversations c where c.id = n.conversation_id and n.read_at is null;
+insert into public.messages (conversation_id, recipient_id, body)
+select c.id, c.buyer_id, 'Yes, any time after 3.' from public.conversations c;
+
+-- Buyer messages again: the read notification is not reused, a new one is armed.
+select set_config('request.jwt.claim.sub', '20000000-0000-0000-0000-000000000002', true);
+do $$
+begin
+  assert (select count(*) = 1 and min(email_status) = 'pending' from public.notifications),
+    'Buyer must get a notification for the seller''s reply';
+end;
+$$;
+with sent as (
+  insert into public.messages (conversation_id, recipient_id, body)
+  select c.id, c.seller_id, 'Great, see you then.' from public.conversations c
+  returning public_id
+) insert into test_messages select 3, public_id from sent;
+do $$
+begin
+  assert (select count(*) = 1 from private.claim_message_email(
+    (select public_id from test_messages where n = 3))), 'A new message after reading must email again';
+end;
+$$;
+
+select set_config('request.jwt.claim.sub', '20000000-0000-0000-0000-000000000001', true);
+do $$
+begin
+  assert (select count(*) = 2 and count(*) filter (where read_at is null) = 1
+    from public.notifications), 'Seller keeps the read notification and gets one new unread one';
+end;
+$$;
+
+reset role;
+select 'notifications tests passed' as result;
+rollback;
