new file mode 100644
index 0000000..2dccbe7
--- /dev/null
+++ b/backend/src/helpers/mailer.ts
@@ -0,0 +1,56 @@
+import nodemailer from 'nodemailer';
+import { env } from '../config/env.js';
+import type { UserDatabase } from '../config/database.js';
+import * as q from '../generated/notifications.queries.js';
+import { logger } from './logger.js';
+import { type EmailContent, messageEmail } from './notificationEmail.js';
+
+let transport: ReturnType<typeof nodemailer.createTransport> | undefined;
+
+// Short timeouts: the sender's request waits for this (serverless may stop
+// work left running after the response), so a slow SMTP server must not hang it.
+function getTransport() {
+  transport ??= nodemailer.createTransport({
+    url: env.SMTP_URL,
+    connectionTimeout: 5000,
+    greetingTimeout: 5000,
+    socketTimeout: 10000,
+  });
+  return transport;
+}
+
+export async function sendEmail(to: string, content: EmailContent) {
+  // Addresses are never built from user-written text: `to` comes from
+  // profiles.email (constrained to @temple.edu) and `from` from env.
+  await getTransport().sendMail({ from: env.MAIL_FROM, to, ...content });
+}
+
+// Called after the message's transaction has committed. Never throws: a failed
+// email must not turn a sent message into an error for the sender.
+export async function notifyMessageByEmail(db: UserDatabase, messageId: string) {
+  try {
+    const [claim] = await db(tx => q.claimMessageEmail.run({ messageId }, tx));
+    // No row: the conversation already had an unread notification (or no email is due).
+    if (!claim?.notification_id) return;
+    let outcome: 'sent' | 'failed' | 'skipped' = 'skipped';
+    if (env.SMTP_URL && claim.recipient_email) {
+      try {
+        await sendEmail(claim.recipient_email, messageEmail({
+          recipientName: claim.recipient_name,
+          senderName: claim.sender_name,
+          listingTitle: claim.listing_title,
+          link: env.NOTIFICATION_LINK_URL,
+        }));
+        outcome = 'sent';
+      } catch (error) {
+        outcome = 'failed';
+        // Log the failure kind only; no addresses or message content.
+        logger.warn('notification email failed: %s', error instanceof Error ? error.name : 'unknown');
+      }
+    }
+    const notificationId = claim.notification_id;
+    await db(tx => q.finishNotificationEmail.run({ notificationId, outcome }, tx));
+  } catch (error) {
+    logger.error('notification email bookkeeping failed: %s', error instanceof Error ? error.message : 'unknown');
+  }
+}
diff --git a/backend/src/helpers/notificationEmail.ts b/backend/src/helpers/notificationEmail.ts
new file mode 100644
index 0000000..0901109
--- /dev/null
+++ b/backend/src/helpers/notificationEmail.ts
@@ -0,0 +1,47 @@
+// Pure functions only: no env import, so unit tests run without a .env.
+
+export interface MessageEmailInput {
+  recipientName: string | null;
+  senderName: string | null;
+  listingTitle: string | null;
+  link: string;
+}
+
+export interface EmailContent {
+  subject: string;
+  text: string;
+  html: string;
+}
+
+const html = (value: string) => value.replace(/[&<>"']/g, ch => ({
+  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
+}[ch]!));
+
+// Names and titles are user-written; keep them on one short line in the subject.
+const oneLine = (value: string, max: number) => {
+  const clean = value.replace(/[\r\n\t]+/g, ' ').replace(/\s+/g, ' ').trim();
+  return clean.length > max ? `${clean.slice(0, max - 1)}…` : clean;
+};
+
+// The message body is deliberately left out: it stays in Hootus, not in
+// inboxes and email-provider logs.
+export function messageEmail(input: MessageEmailInput): EmailContent {
+  const sender = oneLine(input.senderName || 'A Hootus member', 60);
+  const title = input.listingTitle ? oneLine(input.listingTitle, 80) : null;
+  const greeting = input.recipientName ? `Hi ${oneLine(input.recipientName, 60)},` : 'Hi,';
+  const about = title ? ` about "${title}"` : '';
+  const subject = `${sender} sent you a message${about}`;
+  const text = [
+    greeting,
+    '',
+    `${sender} sent you a message on Hootus${about}.`,
+    `Open Hootus to read and reply: ${input.link}`,
+    '',
+    "You'll get one email per conversation until you open it.",
+  ].join('\n');
+  const htmlBody = `<p>${html(greeting)}</p>
+<p><strong>${html(sender)}</strong> sent you a message on Hootus${title ? ` about <strong>${html(title)}</strong>` : ''}.</p>
+<p><a href="${html(input.link)}">Open Hootus to read and reply</a></p>
+<p style="color:#666;font-size:12px">You'll get one email per conversation until you open it.</p>`;
+  return { subject, text, html: htmlBody };
+}
