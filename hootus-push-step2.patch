@@ -0,0 +1,41 @@
+/* global clients */
+// Hootus service worker: shows push notifications and opens Hootus when one is clicked.
+// The payload is built by backend/src/helpers/pushContent.ts.
+
+self.addEventListener('push', event => {
+  let data = {}
+  try {
+    data = event.data ? event.data.json() : {}
+  } catch {
+    data = {}
+  }
+  event.waitUntil(self.registration.showNotification(data.title || 'Hootus', {
+    body: data.body || 'You have something new on Hootus.',
+    // Same tag replaces the previous notification for that conversation.
+    tag: data.tag,
+    renotify: Boolean(data.tag),
+    data: { url: data.url || '/' },
+  }))
+})
+
+self.addEventListener('notificationclick', event => {
+  event.notification.close()
+  // Only ever open pages on this site.
+  let target = new URL('/', self.location.origin)
+  try {
+    const url = new URL(event.notification.data?.url || '/', self.location.origin)
+    if (url.origin === self.location.origin) target = url
+  } catch {
+    // keep the home page
+  }
+  event.waitUntil((async () => {
+    const windows = await clients.matchAll({ type: 'window', includeUncontrolled: true })
+    const open = windows.find(client => client.url === target.href) ?? windows[0]
+    if (open) {
+      await open.focus()
+      if (open.url !== target.href && 'navigate' in open) await open.navigate(target.href).catch(() => {})
+      return
+    }
+    await clients.openWindow(target.href)
+  })())
+})
