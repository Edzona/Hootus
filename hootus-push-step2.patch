diff --git a/supabase/migrations/20261101000000_push_subscriptions.sql b/supabase/migrations/20261101000000_push_subscriptions.sql
new file mode 100644
index 0000000..a915652
--- /dev/null
+++ b/supabase/migrations/20261101000000_push_subscriptions.sql
@@ -0,0 +1,136 @@
+-- Browser push: one row per browser/device that turned notifications on.
+-- The endpoint is a URL on the browser vendor's push service (Google, Mozilla,
+-- Microsoft, Apple). p256dh and auth are the browser's keys for encrypting payloads.
+create table public.push_subscriptions (
+  id bigint generated always as identity primary key,
+  public_id uuid not null unique default gen_random_uuid(),
+  profile_id bigint not null default private.current_profile_id()
+    references public.profiles(id) on delete cascade,
+  -- Unique: one browser has one endpoint. If another account signs in on the same
+  -- browser and subscribes, the row moves to that account (see save function).
+  endpoint text not null unique check (endpoint ~ '^https://' and char_length(endpoint) <= 2048),
+  p256dh text not null check (p256dh ~ '^[A-Za-z0-9_-]{80,100}$'),
+  auth text not null check (auth ~ '^[A-Za-z0-9_-]{16,32}$'),
+  created_at timestamptz not null default now(),
+  last_success_at timestamptz
+);
+
+create index push_subscriptions_profile_idx on public.push_subscriptions (profile_id);
+
+alter table public.notifications
+  add column push_status text not null default 'pending'
+    check (push_status in ('pending', 'sending', 'sent', 'failed', 'skipped')),
+  add column push_attempted_at timestamptz;
+-- Notifications from before push existed are never pushed.
+update public.notifications set push_status = 'skipped';
+
+-- Save (or take over) this browser's subscription for the current member.
+-- Security definer because the same endpoint may currently belong to another
+-- account that signed in on this browser earlier; members cannot see that row.
+create function private.save_push_subscription(sub_endpoint text, sub_p256dh text, sub_auth text)
+returns uuid
+language sql volatile security definer set search_path = ''
+as $$
+  insert into public.push_subscriptions (profile_id, endpoint, p256dh, auth)
+  select (select private.current_profile_id()), sub_endpoint, sub_p256dh, sub_auth
+  where (select private.current_role()) is not null
+  on conflict (endpoint) do update set
+    profile_id = excluded.profile_id,
+    p256dh = excluded.p256dh,
+    auth = excluded.auth,
+    created_at = now(),
+    last_success_at = null
+  returning public_id
+$$;
+revoke all on function private.save_push_subscription(text, text, text) from public, anon, authenticated, hootus_api;
+grant execute on function private.save_push_subscription(text, text, text) to hootus_api;
+
+-- Like claim_message_email: the sender's request claims push delivery for the
+-- notification its message created, once. Returns one row per recipient device,
+-- or a single row with null endpoint when the recipient has no devices.
+create function private.claim_message_push(message_public_id uuid)
+returns table (
+  notification_id uuid,
+  conversation_id uuid,
+  endpoint text,
+  p256dh text,
+  auth text,
+  sender_name text,
+  listing_title text
+)
+language sql volatile security definer set search_path = ''
+as $$
+  with claimed as (
+    update public.notifications n
+    set push_status = 'sending', push_attempted_at = now()
+    from public.messages m
+    join public.conversations c on c.id = m.conversation_id
+    join public.listings l on l.id = c.listing_id
+    where m.public_id = message_public_id
+      and m.sender_id = (select private.current_profile_id())
+      and (select private.current_role()) is not null
+      and n.first_message_id = m.id
+      and n.push_status = 'pending'
+    returning n.public_id, n.recipient_id, c.public_id as conversation, m.sender_id, l.title
+  )
+  select k.public_id, k.conversation, s.endpoint, s.p256dh, s.auth,
+    (select p.full_name from public.profiles p where p.id = k.sender_id), k.title
+  from claimed k
+  left join public.push_subscriptions s on s.profile_id = k.recipient_id
+$$;
+revoke all on function private.claim_message_push(uuid) from public, anon, authenticated, hootus_api;
+grant execute on function private.claim_message_push(uuid) to hootus_api;
+
+-- Record the push outcome and clean up devices that worked or are gone.
+-- dead_endpoints: the push service answered 404/410 (permission revoked, browser
+-- data cleared). Only the recipient's own subscriptions can be removed this way.
+create function private.finish_notification_push(
+  notification_public_id uuid,
+  outcome text,
+  ok_endpoints text[],
+  dead_endpoints text[]
+)
+returns boolean
+language plpgsql volatile security definer set search_path = ''
+as $$
+declare
+  recipient bigint;
+begin
+  update public.notifications n
+  set push_status = outcome
+  from public.messages m
+  where n.public_id = notification_public_id
+    and outcome in ('sent', 'failed', 'skipped')
+    and n.push_status = 'sending'
+    and m.id = n.first_message_id
+    and m.sender_id = (select private.current_profile_id())
+    and (select private.current_role()) is not null
+  returning n.recipient_id into recipient;
+  if recipient is null then
+    return false;
+  end if;
+  update public.push_subscriptions set last_success_at = now()
+  where profile_id = recipient and endpoint = any(coalesce(ok_endpoints, '{}'));
+  delete from public.push_subscriptions
+  where profile_id = recipient and endpoint = any(coalesce(dead_endpoints, '{}'));
+  return true;
+end;
+$$;
+revoke all on function private.finish_notification_push(uuid, text, text[], text[])
+  from public, anon, authenticated, hootus_api;
+grant execute on function private.finish_notification_push(uuid, text, text[], text[]) to hootus_api;
+
+alter table public.push_subscriptions enable row level security;
+
+revoke all on sequence public.push_subscriptions_id_seq from public, anon, authenticated, hootus_api;
+revoke all on public.push_subscriptions from public, anon, authenticated, hootus_api;
+-- Saving goes through save_push_subscription. Members may list and remove their own.
+grant select, delete on public.push_subscriptions to hootus_api;
+
+create policy push_subscriptions_read on public.push_subscriptions for select to hootus_api
+using ((select private.current_role()) is not null
+  and profile_id = (select private.current_profile_id()));
+
+create policy push_subscriptions_delete on public.push_subscriptions for delete to hootus_api
+using ((select private.current_role()) is not null
+  and profile_id = (select private.current_profile_id()));
diff --git a/supabase/queries/push.sql b/supabase/queries/push.sql
new file mode 100644
index 0000000..728a4cd
--- /dev/null
+++ b/supabase/queries/push.sql
@@ -0,0 +1,19 @@
+/* @name SavePushSubscription */
+-- Null id means the caller is not a confirmed member.
+select private.save_push_subscription(:endpoint!::text, :p256dh!::text, :auth!::text) as id;
+
+/* @name DeletePushSubscription */
+-- RLS limits this to your own devices. Zero rows is fine (already removed).
+delete from public.push_subscriptions where endpoint = :endpoint!::text
+returning public_id as id;
+
+/* @name CountPushSubscriptions */
+select count(*)::int as devices from public.push_subscriptions;
+
+/* @name ClaimMessagePush */
+-- Zero rows: no push is due. One row with null endpoint: recipient has no devices.
+select * from private.claim_message_push(:messageId!::uuid);
+
+/* @name FinishNotificationPush */
+select private.finish_notification_push(:notificationId!::uuid, :outcome!::text,
+  :okEndpoints!::text[], :deadEndpoints!::text[]) as finished;
diff --git a/supabase/tests/push.sql b/supabase/tests/push.sql
new file mode 100644
index 0000000..ff128f6
--- /dev/null
+++ b/supabase/tests/push.sql
@@ -0,0 +1,130 @@
+-- Run as postgres in a disposable Supabase project's SQL Editor after migration,
+-- like access_control.sql. All fixtures roll back. Any failure raises an exception.
+begin;
+
+grant hootus_api to postgres;
+
+-- seller (01), buyer (02), outsider (03)
+insert into auth.users (id, email, email_confirmed_at, raw_user_meta_data)
+values
+  ('40000000-0000-0000-0000-000000000001', 'hootus-push-seller@temple.edu', now(), '{"full_name":"Sam Seller"}'),
+  ('40000000-0000-0000-0000-000000000002', 'hootus-push-buyer@temple.edu', now(), '{"full_name":"Bea Buyer"}'),
+  ('40000000-0000-0000-0000-000000000003', 'hootus-push-outsider@temple.edu', now(), '{}');
+
+set local role hootus_api;
+
+-- Seller turns on notifications on a laptop and a phone, then lists a desk.
+select set_config('request.jwt.claim.sub', '40000000-0000-0000-0000-000000000001', true);
+select private.save_push_subscription('https://fcm.googleapis.com/fcm/send/laptop', repeat('A', 87), repeat('a', 22));
+select private.save_push_subscription('https://fcm.googleapis.com/fcm/send/phone', repeat('B', 87), repeat('b', 22));
+insert into public.listings (category, title, price_jpy) values ('sales', 'Push desk', 1500);
+
+-- Outsider has a device of their own.
+select set_config('request.jwt.claim.sub', '40000000-0000-0000-0000-000000000003', true);
+select private.save_push_subscription('https://updates.push.services.mozilla.com/wpush/v2/outsider', repeat('C', 87), repeat('c', 22));
+do $$
+begin
+  assert (select count(*) = 1 from public.push_subscriptions), 'Outsider must see only their own device';
+  begin
+    insert into public.push_subscriptions (endpoint, p256dh, auth)
+    values ('https://fcm.googleapis.com/fcm/send/direct', repeat('D', 87), repeat('d', 22));
+    raise exception 'Members must save subscriptions through the API function';
+  exception when insufficient_privilege then null;
+  end;
+  begin
+    perform private.save_push_subscription('http://fcm.googleapis.com/insecure', repeat('D', 87), repeat('d', 22));
+    raise exception 'Non-HTTPS endpoints must be rejected';
+  exception when check_violation then null;
+  end;
+end;
+$$;
+delete from public.push_subscriptions where endpoint like '%/laptop';
+
+-- Buyer starts a conversation and messages twice.
+select set_config('request.jwt.claim.sub', '40000000-0000-0000-0000-000000000002', true);
+insert into public.conversations (listing_id, seller_id)
+select id, author_id from public.listings where title = 'Push desk';
+
+create temporary table test_messages (n int, public_id uuid) on commit drop;
+grant all on test_messages to hootus_api;
+with sent as (
+  insert into public.messages (conversation_id, recipient_id, body)
+  select c.id, c.seller_id, 'Is it available?' from public.conversations c
+  returning public_id
+) insert into test_messages select 1, public_id from sent;
+with sent as (
+  insert into public.messages (conversation_id, recipient_id, body)
+  select c.id, c.seller_id, 'Still there?' from public.conversations c
+  returning public_id
+) insert into test_messages select 2, public_id from sent;
+
+do $$
+declare
+  notification uuid;
+begin
+  assert (select count(*) = 0 from public.push_subscriptions), 'Buyer must not see the seller''s devices';
+  assert (select count(*) = 0 from private.claim_message_push(
+    (select public_id from test_messages where n = 2))), 'A grouped message must not push again';
+
+  create temporary table claimed on commit drop as
+    select * from private.claim_message_push((select public_id from test_messages where n = 1));
+  assert (select count(*) = 2 from claimed), 'Push must reach both of the seller''s devices (outsider delete had no effect)';
+  assert (select bool_and(sender_name = 'Bea Buyer' and listing_title = 'Push desk' and conversation_id is not null)
+    from claimed), 'Push claim must describe the message';
+  assert (select count(*) = 0 from private.claim_message_push(
+    (select public_id from test_messages where n = 1))), 'Push must only be claimed once';
+
+  -- The phone is gone (410). Also try to delete the outsider's device: must not work.
+  notification := (select notification_id from claimed limit 1);
+  assert private.finish_notification_push(notification, 'sent',
+    array['https://fcm.googleapis.com/fcm/send/laptop'],
+    array['https://fcm.googleapis.com/fcm/send/phone',
+          'https://updates.push.services.mozilla.com/wpush/v2/outsider']), 'Sender records the push outcome';
+  assert not private.finish_notification_push(notification, 'failed', '{}', '{}'), 'A push outcome is final';
+end;
+$$;
+
+-- Seller: the dead phone was removed, the laptop marked working, status recorded.
+select set_config('request.jwt.claim.sub', '40000000-0000-0000-0000-000000000001', true);
+do $$
+begin
+  assert (select count(*) = 1 and bool_and(endpoint like '%/laptop' and last_success_at is not null)
+    from public.push_subscriptions), 'Dead device removed, working device kept';
+  assert (select min(push_status) = 'sent' and min(email_status) = 'pending'
+    from public.notifications), 'Push and email are tracked separately';
+  assert (select count(*) = 0 from private.claim_message_push(
+    (select public_id from test_messages where n = 1))), 'Recipient must not claim the sender''s push';
+end;
+$$;
+
+-- Outsider's device survived the attempted delete. Then the outsider signs in on the
+-- seller's laptop browser and subscribes: the endpoint moves to the outsider.
+select set_config('request.jwt.claim.sub', '40000000-0000-0000-0000-000000000003', true);
+select private.save_push_subscription('https://fcm.googleapis.com/fcm/send/laptop', repeat('E', 87), repeat('e', 22));
+do $$
+begin
+  assert (select count(*) = 2 from public.push_subscriptions), 'Outsider keeps their device and takes over the laptop';
+end;
+$$;
+
+-- Seller now has no devices; a new message still claims, with a single null-endpoint row.
+update public.notifications set read_at = now();  -- no effect for outsider (RLS), kept for symmetry
+select set_config('request.jwt.claim.sub', '40000000-0000-0000-0000-000000000001', true);
+update public.notifications set read_at = now() where read_at is null;
+select set_config('request.jwt.claim.sub', '40000000-0000-0000-0000-000000000002', true);
+with sent as (
+  insert into public.messages (conversation_id, recipient_id, body)
+  select c.id, c.seller_id, 'Hello again' from public.conversations c
+  returning public_id
+) insert into test_messages select 3, public_id from sent;
+do $$
+begin
+  assert (select count(*) = 1 and bool_and(endpoint is null and notification_id is not null)
+    from private.claim_message_push((select public_id from test_messages where n = 3))),
+    'Recipient without devices yields one row with a null endpoint';
+end;
+$$;
+
+reset role;
+select 'push tests passed' as result;
+rollback;
