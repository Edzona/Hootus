+import { useEffect, useId, useState } from 'react'
+import { getSupabase } from '../lib/supabase'
+import { apiRequest } from '../lib/api'
+
+const MAX_BIO = 500
+const MAX_PHOTO_BYTES = 2 * 1024 * 1024
+const photoTypes = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' }
+const avatarMarker = '/storage/v1/object/public/avatars/'
+
+// File path inside the avatars bucket, or null for anything else.
+function avatarPath(url) {
+  const index = url ? url.indexOf(avatarMarker) : -1
+  return index === -1 ? null : url.slice(index + avatarMarker.length)
+}
+
+export default function ProfileEditor({ profile, onSaved }) {
+  const [bio, setBio] = useState(profile.bio || '')
+  const [photo, setPhoto] = useState(null)
+  const [removePhoto, setRemovePhoto] = useState(false)
+  const [saving, setSaving] = useState(false)
+  const [message, setMessage] = useState(null)
+  const bioId = useId()
+  const photoId = useId()
+
+  // Free the local preview when it is replaced or the editor closes.
+  useEffect(() => () => { if (photo) URL.revokeObjectURL(photo.preview) }, [photo])
+
+  const preview = photo?.preview || (removePhoto ? null : profile.avatar_url)
+  const changed = Boolean(photo) || removePhoto || bio.trim() !== (profile.bio || '')
+
+  function choosePhoto(event) {
+    const file = event.target.files?.[0]
+    event.target.value = ''
+    if (!file) return
+    if (!photoTypes[file.type]) return setMessage({ error: true, text: 'Choose a JPEG, PNG or WebP image.' })
+    if (file.size > MAX_PHOTO_BYTES) return setMessage({ error: true, text: 'Photos must be 2 MB or smaller.' })
+    setMessage(null)
+    setRemovePhoto(false)
+    setPhoto({ file, preview: URL.createObjectURL(file) })
+  }
+
+  function clearPhoto() {
+    setPhoto(null)
+    setRemovePhoto(Boolean(profile.avatar_url))
+  }
+
+  async function save(event) {
+    event.preventDefault()
+    setSaving(true)
+    setMessage(null)
+    let uploadedPath = null
+    try {
+      const storage = getSupabase().storage.from('avatars')
+      const body = { bio }
+      if (photo) {
+        const { data } = await getSupabase().auth.getSession()
+        if (!data.session) throw new Error('Please sign in again.')
+        // Storage only accepts files inside your own folder: avatars/<your Auth ID>/.
+        const path = `${data.session.user.id}/${crypto.randomUUID()}.${photoTypes[photo.file.type]}`
+        const { error } = await storage.upload(path, photo.file, { contentType: photo.file.type })
+        if (error) throw new Error('Your photo could not be uploaded. Please try again.')
+        uploadedPath = path
+        body.avatar_url = storage.getPublicUrl(path).data.publicUrl
+      } else if (removePhoto) {
+        body.avatar_url = null
+      }
+      const saved = await apiRequest('/profile/me', { method: 'PATCH', body })
+      uploadedPath = null
+      // Best effort: remove the replaced photo so old files do not pile up.
+      const oldPath = avatarPath(profile.avatar_url)
+      if ((photo || removePhoto) && oldPath) await storage.remove([oldPath])
+      onSaved(saved)
+      setBio(saved.bio || '')
+      setPhoto(null)
+      setRemovePhoto(false)
+      setMessage({ error: false, text: 'Profile saved.' })
+    } catch (error) {
+      if (uploadedPath) await getSupabase().storage.from('avatars').remove([uploadedPath])
+      setMessage({ error: true, text: error.message })
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  return (
+    <form onSubmit={save} className="border-2 border-ink bg-white p-6 shadow-hard md:col-span-2 md:p-8">
+      <p className="eyebrow">02 / Edit profile</p>
+      <div className="mt-6 grid gap-8 md:grid-cols-[auto_1fr]">
+        <div>
+          <span className="eyebrow text-ink/60">Photo</span>
+          <div className="mt-3 grid h-32 w-32 place-items-center overflow-hidden border-2 border-ink bg-matcha">
+            {preview
+              ? <img src={preview} alt="Your profile photo preview" className="h-full w-full object-cover" />
+              : <span className="px-2 text-center font-mono text-xs uppercase">No photo</span>}
+          </div>
+          <div className="mt-4 flex flex-col items-start gap-2">
+            <label htmlFor={photoId} className="cursor-pointer font-mono text-xs uppercase tracking-widest underline">
+              {preview ? 'Change photo' : 'Upload photo'}
+            </label>
+            <input id={photoId} type="file" accept="image/jpeg,image/png,image/webp" className="sr-only"
+              onChange={choosePhoto} disabled={saving} />
+            {preview && (
+              <button type="button" onClick={clearPhoto} disabled={saving}
+                className="font-mono text-xs uppercase tracking-widest text-cherry underline">
+                Remove photo
+              </button>
+            )}
+            <p className="text-xs text-ink/60">JPEG, PNG or WebP, up to 2 MB.</p>
+          </div>
+        </div>
+        <div>
+          <label htmlFor={bioId} className="eyebrow text-ink/60">Bio</label>
+          <textarea id={bioId} value={bio} onChange={event => setBio(event.target.value)} maxLength={MAX_BIO}
+            rows={6} disabled={saving} placeholder="Major, year, clubs, what you're looking for on campus…"
+            className="mt-3 w-full resize-y border-2 border-ink bg-paper p-4 text-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" />
+          <p className="mt-1 text-right font-mono text-xs text-ink/60">{bio.length}/{MAX_BIO}</p>
+        </div>
+      </div>
+      <div className="mt-6 flex flex-wrap items-center gap-6">
+        <button type="submit" className="btn-primary disabled:opacity-50" disabled={saving || !changed}>
+          {saving ? 'Saving…' : 'Save profile →'}
+        </button>
+        {message && (
+          <p role={message.error ? 'alert' : 'status'} className={message.error ? 'text-cherry' : 'text-ink/70'}>
+            {message.text}
+          </p>
+        )}
+      </div>
+    </form>
+  )
+}
