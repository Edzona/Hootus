{
  "name": "hootus-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "RUN_INTEGRATION=1 tsx --test tests/*.test.ts",
    "sql:generate": "node scripts/sql.mjs",
    "sql:check": "node scripts/sql.mjs --check",
    "sql:watch": "node scripts/sql.mjs --watch",
    "predev": "npm run sql:generate",
    "check": "npm run sql:check && npm run build && npm test"
  },
  "dependencies": {
    "@pgtyped/runtime": "2.4.2",
    "@supabase/supabase-js": "2.109.0",
    "cors": "2.8.6",
    "debug": "4.4.3",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pgtyped/cli": "2.4.3",
    "@types/cors": "2.8.19",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@pgtyped/cli": {
      "tinypool": "^2.1.2"
    }
  }
}
