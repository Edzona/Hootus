PORT=5000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-or-anon-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable Hootus logs; leave empty to disable. On Vercel set this explicitly.
DEBUG=hootus:*

# Notification email. Locally this is Supabase's Mailpit SMTP port; enable it with
# smtp_port = 54325 under [local_smtp] in supabase/config.toml. Leave empty to disable.
# Hosted: your email provider's SMTP URL, e.g. smtps://USER:PASSWORD@smtp.example.com:465
SMTP_URL=smtp://127.0.0.1:54325
MAIL_FROM=Hootus <no-reply@hootus.local>
NOTIFICATION_LINK_URL=http://localhost:5173/#/beta/listings

# Server-only dedicated login. Set its password outside migrations.
# Local: use your local Postgres port; hosted: use the transaction pooler (6543).
DATABASE_URL=postgresql://hootus_server:postgres@127.0.0.1:54322/postgres
# Hosted username: hootus_server.PROJECT_REF; never put this URL in VITE_*.

# Development only: local schema introspection for PgTyped, never deploy this.
SQL_GENERATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
